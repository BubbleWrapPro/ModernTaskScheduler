<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModernTaskScheduler.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModernTaskScheduler"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ModernTaskScheduler">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <ListView x:Name="TaskListView" Grid.Column="0" SelectionChanged="TaskListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,5">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding State}" FontSize="12" Foreground="Gray"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="DetailsPanel" Grid.Column="1" Padding="20">
            <TextBlock x:Name="TaskNameText" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="TaskStateText" FontSize="16" Margin="0,10,0,0"/>
            <TextBlock x:Name="TaskNextRunText" FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModernTaskScheduler.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ModernTaskScheduler"
    xmlns:vm="using:ModernTaskScheduler.ViewModels"
    xmlns:models="using:ModernTaskScheduler.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Modern Task Scheduler v1.0.0">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: APP HEADER & ACTIONS -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE823;" FontSize="22" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    <StackPanel>
                        <TextBlock Text="Modern Task Scheduler" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="v1.0.0 - Professional Task Management" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Search Box -->
                <AutoSuggestBox Grid.Column="1"
                                MaxWidth="420"
                                HorizontalAlignment="Center"
                                PlaceholderText="Rechercher une tâche (nom, description, auteur)..."
                                QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Top Right Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.RefreshCommand}"
                            ToolTipService.ToolTip="Refresh folders and tasks">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.CreateTaskCommand}"
                            ToolTipService.ToolTip="Create a new scheduled task">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                            <TextBlock Text="New Task"/>
                        </StackPanel>
                    </Button>

                    <Button Click="AboutButton_Click"
                            ToolTipService.ToolTip="About this application">
                        <FontIcon Glyph="&#xE946;" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- NOTIFICATION INFOBAR -->
        <InfoBar Grid.Row="1"
                 IsOpen="{x:Bind ViewModel.IsInfoBarOpen, Mode=TwoWay}"
                 Title="{x:Bind ViewModel.InfoBarTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.InfoBarMessage, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.InfoBarSeverity, Mode=OneWay}"
                 IsClosable="True"/>

        <!-- MASTER - DETAILS GRID -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" MaxWidth="500"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT PANEL: MASTER ================= -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorAltBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Folder Selector Header & Actions -->
                <Grid Grid.Row="0" Padding="14,12,14,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="DOSSIERS DE LA BIBLIOTHÈQUE"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Style="{ThemeResource DefaultButtonStyle}"
                                    Padding="6,3"
                                    ToolTipService.ToolTip="Créer un nouveau sous-dossier"
                                    Command="{x:Bind ViewModel.CreateFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8F4;" FontSize="11"/>
                                    <TextBlock Text="Nouveau" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{ThemeResource DefaultButtonStyle}"
                                    Padding="6,3"
                                    ToolTipService.ToolTip="Supprimer ce dossier"
                                    Command="{x:Bind ViewModel.DeleteFolderCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanDeleteSelectedFolder, Mode=OneWay}">
                                <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ComboBox Grid.Row="1"
                              HorizontalAlignment="Stretch"
                              ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedFolder, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:TaskFolderItem">
                                <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- Filter Chips -->
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              Padding="14,4,14,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Toutes"
                                Click="FilterAll_Click"
                                Style="{ThemeResource DefaultButtonStyle}"/>
                        <Button Content="En cours"
                                Click="FilterRunning_Click"
                                Style="{ThemeResource DefaultButtonStyle}"/>
                        <Button Content="Prêtes"
                                Click="FilterReady_Click"
                                Style="{ThemeResource DefaultButtonStyle}"/>
                        <Button Content="Désactivées"
                                Click="FilterDisabled_Click"
                                Style="{ThemeResource DefaultButtonStyle}"/>
                        <Button Command="{x:Bind ViewModel.LoadAllTasksCommand}"
                                ToolTipService.ToolTip="Afficher récursivement toutes les tâches de toutes les branches"
                                Style="{ThemeResource DefaultButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE8B9;" FontSize="12"/>
                                <TextBlock Text="Tout explorer"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tasks ListView & Loading -->
                <Grid Grid.Row="2">
                    <!-- Loading Bar -->
                    <ProgressBar VerticalAlignment="Top"
                                 IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"/>

                    <!-- List of Tasks -->
                    <ListView ItemsSource="{x:Bind ViewModel.FilteredTasks, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTask, Mode=TwoWay}"
                              SelectionMode="Single"
                              Padding="10,4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:TaskItemViewModel">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,3"
                                        Padding="10,8">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- State indicator dot / icon -->
                                        <Border Grid.Column="0"
                                                Width="28" Height="28"
                                                CornerRadius="14"
                                                Background="{x:Bind StateBadgeBg}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{x:Bind StateIconGlyph}"
                                                      FontSize="13"
                                                      Foreground="{x:Bind StateBadgeColor}"/>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind StateDisplay}"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind NextRunTimeDisplay}"
                                                           FontSize="10"
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Status Footer -->
                <Border Grid.Row="3"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.TotalTasksCount, Mode=OneWay}" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock Text="tâches" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- SEPARATOR -->
            <Border Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}"/>

            <!-- ================= RIGHT PANEL: DETAILS ================= -->
            <Grid Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}">

                <!-- EMPTY STATE WHEN NO TASK SELECTED -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="14"
                            MaxWidth="400"
                            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE823;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                    </Border>
                    <TextBlock Text="Aucune tâche sélectionnée"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Sélectionnez une tâche dans la colonne de gauche pour afficher et gérer ses déclencheurs, actions, conditions et paramètres avancés, ou créez une nouvelle tâche dès maintenant."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontSize="13"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button HorizontalAlignment="Center"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.CreateTaskCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;"/>
                            <TextBlock Text="Créer une nouvelle tâche"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- TASK DETAILS VIEW -->
                <Grid Visibility="{x:Bind ViewModel.TaskDetailsVisibility, Mode=OneWay}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- DETAILS HEADER & COMMAND BAR -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,14">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Task Title & Badges -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedTask.Name, Mode=OneWay}"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTask.Path, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTask.Author, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Status Badge Pill -->
                                <Border Grid.Column="1"
                                        Background="{x:Bind ViewModel.SelectedTask.StateBadgeBg, Mode=OneWay}"
                                        CornerRadius="16"
                                        Padding="12,6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind ViewModel.SelectedTask.StateIconGlyph, Mode=OneWay}"
                                                  FontSize="13"
                                                  Foreground="{x:Bind ViewModel.SelectedTask.StateBadgeColor, Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedTask.StateDisplay, Mode=OneWay}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{x:Bind ViewModel.SelectedTask.StateBadgeColor, Mode=OneWay}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Action CommandBar -->
                            <CommandBar Grid.Row="1"
                                        DefaultLabelPosition="Right"
                                        Background="Transparent">
                                <AppBarButton Icon="Play"
                                              Label="Exécuter"
                                              ToolTipService.ToolTip="Exécuter immédiatement cette tâche"
                                              Command="{x:Bind ViewModel.RunSelectedTaskCommand}"
                                              IsEnabled="{x:Bind ViewModel.SelectedTask.CanRun, Mode=OneWay}"/>

                                <AppBarButton Icon="Stop"
                                              Label="Arrêter"
                                              ToolTipService.ToolTip="Arrêter l'exécution de la tâche en cours"
                                              Command="{x:Bind ViewModel.StopSelectedTaskCommand}"
                                              IsEnabled="{x:Bind ViewModel.SelectedTask.CanStop, Mode=OneWay}"/>

                                <AppBarSeparator/>

                                <AppBarButton Icon="Sync"
                                              Label="Activer / Désactiver"
                                              ToolTipService.ToolTip="Activer ou désactiver cette tâche"
                                              Click="ToggleEnabled_Click"/>

                                <AppBarButton Icon="Edit"
                                              Label="Modifier"
                                              ToolTipService.ToolTip="Modifier les propriétés de la tâche"
                                              Command="{x:Bind ViewModel.EditSelectedTaskCommand}"/>

                                <AppBarButton Icon="Delete"
                                              Label="Supprimer"
                                              ToolTipService.ToolTip="Supprimer définitivement cette tâche"
                                              Command="{x:Bind ViewModel.DeleteSelectedTaskCommand}"/>

                                <AppBarSeparator/>

                                <AppBarButton Icon="SaveLocal"
                                              Label="Exporter XML"
                                              ToolTipService.ToolTip="Copier la définition XML de la tâche"
                                              Command="{x:Bind ViewModel.ExportXmlCommand}"/>

                                <AppBarButton Icon="Refresh"
                                              Label="Actualiser"
                                              ToolTipService.ToolTip="Recharger les propriétés de cette tâche"
                                              Command="{x:Bind ViewModel.RefreshCommand}"/>
                            </CommandBar>
                        </Grid>
                    </Border>

                    <!-- TAB VIEW: PROPERTIES DETAILS -->
                    <TabView Grid.Row="1"
                             CanReorderTabs="False"
                             IsAddTabButtonVisible="False"
                             Padding="16">

                        <!-- TAB 1: GÉNÉRAL -->
                        <TabViewItem Header="Général" IsClosable="False">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE946;"/>
                            </TabViewItem.IconSource>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,16">
                                <StackPanel Spacing="16">

                                    <!-- Description Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Description" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{x:Bind ViewModel.SelectedTask.Description, Mode=OneWay}"
                                                       TextWrapping="Wrap"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Execution Status Diagnostics Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="État d'exécution &amp; Diagnostics" FontWeight="SemiBold" FontSize="14"/>
                                            <Grid ColumnSpacing="20" RowSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2">
                                                    <TextBlock Text="Dernière exécution" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedTask.LastRunTimeDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Grid.Row="0" Spacing="2">
                                                    <TextBlock Text="Prochaine exécution planifiée" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedTask.NextRunTimeDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Spacing="2">
                                                    <TextBlock Text="Résultat de la dernière exécution" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedTask.LastTaskResultDisplay, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Security & Account Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Compte et privilèges de sécurité" FontWeight="SemiBold" FontSize="14"/>
                                            <Grid ColumnSpacing="20" RowSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="Compte utilisateur" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedTask.PrincipalUser, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="Niveau d'élévation" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    <TextBlock Text="{x:Bind ViewModel.SelectedTask.RunLevelDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabViewItem>

                        <!-- TAB 2: DÉCLENCHEURS (TRIGGERS) -->
                        <TabViewItem Header="Déclencheurs" IsClosable="False">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE823;"/>
                            </TabViewItem.IconSource>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,16">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedTask.Triggers, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:TriggerDisplayItem">
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Margin="0,0,0,10"
                                                    Padding="14">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{ThemeResource LayerFillColorAltBrush}" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind TriggerType}" FontWeight="SemiBold" FontSize="14"/>
                                                        <TextBlock Text="{x:Bind Details}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{x:Bind Repetition}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                    </StackPanel>

                                                    <Border Grid.Column="2"
                                                            Background="{ThemeResource LayerFillColorAltBrush}"
                                                            CornerRadius="4"
                                                            Padding="8,4"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind StatusDisplay}" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabViewItem>

                        <!-- TAB 3: ACTIONS -->
                        <TabViewItem Header="Actions" IsClosable="False">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE756;"/>
                            </TabViewItem.IconSource>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,16">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedTask.Actions, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ActionDisplayItem">
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Margin="0,0,0,10"
                                                    Padding="14">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{ThemeResource LayerFillColorAltBrush}" VerticalAlignment="Center">
                                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind ActionType}" FontWeight="SemiBold" FontSize="14"/>
                                                        <Grid ColumnSpacing="10" RowSpacing="4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Programme / Script :" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Grid.Column="1" Grid.Row="0" Text="{x:Bind Path}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                                            <TextBlock Grid.Column="0" Grid.Row="1" Text="Arguments :" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Grid.Column="1" Grid.Row="1" Text="{x:Bind Arguments}" FontSize="11" TextWrapping="Wrap"/>

                                                            <TextBlock Grid.Column="0" Grid.Row="2" Text="Dossier de travail :" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                            <TextBlock Grid.Column="1" Grid.Row="2" Text="{x:Bind WorkingDirectory}" FontSize="11"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabViewItem>

                        <!-- TAB 4: CONDITIONS -->
                        <TabViewItem Header="Conditions" IsClosable="False">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE946;"/>
                            </TabViewItem.IconSource>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,16">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedTask.Conditions, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ConditionDisplayItem">
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Margin="0,0,0,8"
                                                    Padding="12,10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{x:Bind Category}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{x:Bind Value}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabViewItem>

                        <!-- TAB 5: PARAMÈTRES (SETTINGS) -->
                        <TabViewItem Header="Paramètres" IsClosable="False">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE713;"/>
                            </TabViewItem.IconSource>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,16">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedTask.Settings, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:SettingDisplayItem">
                                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Margin="0,0,0,8"
                                                    Padding="12,10">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <FontIcon Grid.Column="0" Glyph="{x:Bind IconGlyph}" FontSize="16" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{x:Bind Description}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{x:Bind Value}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabViewItem>

                        <!-- TAB 6: DÉFINITION XML -->
                        <TabViewItem Header="Définition XML" IsClosable="False">
                            <TabViewItem.IconSource>
                                <FontIconSource Glyph="&#xE943;"/>
                            </TabViewItem.IconSource>
                            <Grid Padding="12,16" RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Button Grid.Row="0"
                                        Command="{x:Bind ViewModel.CopySelectedXmlCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C8;"/>
                                        <TextBlock Text="Copier le XML dans le presse-papiers"/>
                                    </StackPanel>
                                </Button>

                                <TextBox Grid.Row="1"
                                         Text="{x:Bind ViewModel.SelectedTask.XmlDefinition, Mode=OneWay}"
                                         IsReadOnly="True"
                                         FontFamily="Consolas, Cascadia Code, Courier New"
                                         FontSize="12"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="True"/>
                            </Grid>
                        </TabViewItem>

                    </TabView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
